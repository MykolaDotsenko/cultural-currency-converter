{
  "name": "cultural-currency-converter-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "quality": "npm run typecheck && npm run check && npm run build && npm run perf:budget",
    "perf:budget": "node scripts/check-performance-budgets.mjs",
    "browser:quality": "node scripts/browser-quality.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@github/combobox-nav": "3.0.2",
    "chart.js": "4.5.1",
    "htmx.org": "2.0.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.6",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
