# Explicit execution context: local | test | preview | production
APP_ENV=local

# Local defaults to true. Preview/production must be false.
DJANGO_DEBUG=true

# Comma-separated host names; do not include http:// or https://.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Optional for local/test. Required (>=50 chars) for preview/production.
# Set this locally when persistent sessions across process restarts are useful.
DJANGO_SECRET_KEY=

# HTTPS topology is explicit in deployed environments: "direct" when Django receives HTTPS
# itself, or "proxy" only behind a trusted TLS-terminating reverse proxy that sets X-Forwarded-Proto.
# Required for preview/production.
DJANGO_HTTPS_MODE=

# Preview may keep HSTS at 0 while TLS topology is being verified.
# Production requires a positive value; start small and increase only after HTTPS is proven stable.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

# CSP rollout: local defaults to disabled, test defaults to enforce.
# Preview/production require an explicit report-only or enforce choice.
DJANGO_CSP_MODE=

# Optional for local/test: omit to use SQLite.
# Required for preview/production and must use postgresql:// or postgres://.
# Example local PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cultural_currency
DATABASE_URL=

# Optional for local/test: omit to use process-local memory cache.
# Required for preview/production. Use rediss:// when the cache crosses a trusted private network boundary.
# Example local Redis:
# CACHE_URL=redis://127.0.0.1:6379/0
CACHE_URL=

# Managed media storage. Local/test/demo/preview default to local filesystem.
# Production requires MEDIA_STORAGE_BACKEND=s3 so uploaded/curated media does not
# disappear with an ephemeral application filesystem.
MEDIA_STORAGE_BACKEND=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
# Public HTTPS origin used by generated media URLs and the CSP img-src allowlist.
# Example: https://media.example.com
MEDIA_S3_PUBLIC_ORIGIN=
# Optional S3-compatible API origin for providers such as R2 or Spaces.
MEDIA_S3_ENDPOINT_URL=
# S3 credentials use the provider/IAM chain or standard AWS_* environment variables.

# Optional import-only REST Countries v5 configuration.
# Required only when running `python manage.py sync_country_metadata`.
REST_COUNTRIES_API_KEY=
REST_COUNTRIES_BASE_URL=https://api.restcountries.com/countries/v5

# Runtime FX provider configuration. Frankfurter public v2 requires no API key.
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2
FRANKFURTER_TIMEOUT_SECONDS=3
# Test-only deterministic provider used by browser/release-quality automation.
# Runtime configuration rejects this flag unless APP_ENV=test.
FX_TEST_FIXTURE_ENABLED=false

# Optional editorial media ingestion. Required only for Europeana candidate search.
EUROPEANA_API_KEY=

# Optional runtime AI explanation. Core conversion remains AI-independent.
# Keep disabled unless a server-side Gemini key is configured.
AI_PROVIDER=google
AI_TEXT_MODEL=gemini-3.1-flash-lite
AI_RUNTIME_EXPLANATION_ENABLED=false
# Test-only deterministic runtime explanation provider. Rejected unless APP_ENV=test.
AI_RUNTIME_TEST_FIXTURE_ENABLED=false
# Optional multimodal amount extraction for explicit user-uploaded travel-money images.
# Raw images are processed ephemerally and are not persisted by the application.
AI_CAMERA_EXTRACTION_ENABLED=false
AI_EDITORIAL_GENERATION_ENABLED=false
AI_IMAGE_GENERATION_ENABLED=false
AI_FALLBACK_MODE=deterministic
AI_TIMEOUT_SECONDS=5
AI_MAX_ATTEMPTS=2
GEMINI_API_KEY=
